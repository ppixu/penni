{
  "name": "@penni/pilvi",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.mittaus.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.mittaus.json",
    "dev": "wrangler dev --local --var PAIKALLINEN_WORKERD:1 --var PILVI_KEHITYS_TUONTI:1",
    "test": "vitest run && vitest run -c vitest.mittaus.config.ts",
    "test:watch": "vitest",
    "mittaa": "tsx mittaus/mittaa.ts",
    "test:mittaus": "vitest run -c vitest.mittaus.config.ts"
  },
  "dependencies": {
    "@penni/charts": "workspace:*",
    "@penni/contract": "workspace:*",
    "@penni/control": "workspace:*",
    "@penni/engine": "workspace:*",
    "@penni/server": "workspace:*",
    "@penni/storage-do": "workspace:*",
    "@penni/storage-sqlite-core": "workspace:*",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/serverless": "3.52.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@penni/asiakas": "workspace:*",
    "@penni/euro": "workspace:*",
    "@penni/storage-sqlite": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "better-sqlite3": "^12.11.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "4.72.0"
  }
}
